@page "{id:int}"
@model Films.Web.Pages.Films.DetailsModel
@{
    ViewData["Title"] = "Film Details";
}

<div class="container">
    <h1>Film Details</h1>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Film?.Title</dd>
                
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Film?.Description</dd>
                
                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@Model.Film?.Year</dd>
                
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@Model.Film?.Genre</dd>
                
                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Film?.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                
                @if (Model.Film?.ModifiedDate != null)
                {
                    <dt class="col-sm-3">Modified Date</dt>
                    <dd class="col-sm-9">@Model.Film.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                }
            </dl>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-page="Edit" asp-route-id="@Model.Film?.Id" class="btn btn-warning">Edit</a>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
