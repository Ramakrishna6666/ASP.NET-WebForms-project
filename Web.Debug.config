<?xml version="1.0" encoding="utf-8"?>
<!--
  CLOUD READINESS MIGRATION (cr-dotnet-0010):
  Web.config transformation files (Web.Debug.config, Web.Release.config) have been
  eliminated in favor of environment variables and AWS Systems Manager Parameter Store.
  
  Configuration is now injected at runtime rather than baked into build artifacts,
  enabling true infrastructure-as-code and immutable deployments on AWS.
  
  MIGRATION GUIDE:
  All settings previously managed via Web.config transformations should be externalized:
  
  1. CONNECTION STRINGS -> AWS Systems Manager Parameter Store or AWS Secrets Manager:
     - Parameter: /films-app/{environment}/ConnectionStrings/DefaultConnection
     - Parameter: /films-app/{environment}/ConnectionStrings/filmsEntities
     - Access via: Amazon.Extensions.Configuration.SystemsManager NuGet package
  
  2. DEBUG SETTINGS -> Environment Variables:
     - ASPNETCORE_ENVIRONMENT=Development (replaces debug="true" compilation attribute)
     - Set in AWS ECS Task Definition or EKS ConfigMap
  
  3. CUSTOM ERRORS -> Environment Variables:
     - ASPNETCORE_ENVIRONMENT=Production enables production error handling
     - No need for customErrors transformation
  
  4. APPSETTINGS -> AWS Systems Manager Parameter Store:
     - /films-app/{environment}/AppSettings/{key}
     - Loaded at startup via IConfiguration with SSM provider
  
  EXAMPLE appsettings.json (replaces Web.config + transformations):
  {
    "AWS": {
      "Region": "us-east-1",
      "ParameterStore": {
        "Prefix": "/films-app/",
        "ReloadAfter": "00:05:00"
      }
    }
  }
  
  EXAMPLE Program.cs SSM integration:
  Host.CreateDefaultBuilder(args)
      .ConfigureAppConfiguration((context, config) => {
          config.AddSystemsManager($"/films-app/{context.HostingEnvironment.EnvironmentName}/");
      })
  
  This file is retained for reference only and is NOT used in cloud deployments.
  Remove this file from the project once migration to ASP.NET Core is complete.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    DEPRECATED: Web.config transformations are not used in cloud deployments.
    All environment-specific configuration is managed via:
    - Environment variables (set in AWS ECS Task Definition / EKS ConfigMap)
    - AWS Systems Manager Parameter Store (for non-sensitive config)
    - AWS Secrets Manager (for sensitive config: passwords, API keys, tokens)
    
    See MIGRATION GUIDE above for details.
  -->
</configuration>
