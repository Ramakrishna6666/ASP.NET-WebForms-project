<?xml version="1.0" encoding="utf-8"?>
<!--
  CLOUD READINESS MIGRATION (cr-dotnet-0010):
  Web.config transformation files (Web.Debug.config, Web.Release.config) have been
  eliminated in favor of environment variables and AWS Systems Manager Parameter Store.
  
  Configuration is now injected at runtime rather than baked into build artifacts,
  enabling true infrastructure-as-code and immutable deployments on AWS.
  
  MIGRATION GUIDE:
  All settings previously managed via Web.config transformations should be externalized:
  
  1. CONNECTION STRINGS -> AWS Systems Manager Parameter Store or AWS Secrets Manager:
     - Parameter: /films-app/production/ConnectionStrings/DefaultConnection
     - Parameter: /films-app/production/ConnectionStrings/filmsEntities
     - Access via: Amazon.Extensions.Configuration.SystemsManager NuGet package
  
  2. COMPILATION DEBUG REMOVAL -> Environment Variables:
     - ASPNETCORE_ENVIRONMENT=Production (replaces xdt:Transform="RemoveAttributes(debug)")
     - Set in AWS ECS Task Definition or EKS ConfigMap
     - ASP.NET Core automatically disables debug features in Production environment
  
  3. CUSTOM ERRORS -> Environment Variables:
     - ASPNETCORE_ENVIRONMENT=Production enables production error handling middleware
     - No need for customErrors transformation
  
  4. RELEASE OPTIMIZATIONS -> Environment Variables + appsettings.Production.json:
     - ASPNETCORE_ENVIRONMENT=Production
     - appsettings.Production.json loaded automatically by ASP.NET Core
  
  EXAMPLE AWS ECS Task Definition environment variables:
  {
    "environment": [
      {"name": "ASPNETCORE_ENVIRONMENT", "value": "Production"},
      {"name": "ASPNETCORE_URLS", "value": "http://0.0.0.0:8080"},
      {"name": "AWS_REGION", "value": "us-east-1"}
    ],
    "secrets": [
      {
        "name": "ConnectionStrings__DefaultConnection",
        "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789:secret:films-app/db-connection"
      }
    ]
  }
  
  EXAMPLE appsettings.Production.json (replaces Web.Release.config):
  {
    "Logging": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "AWS": {
      "Region": "us-east-1",
      "ParameterStore": {
        "Prefix": "/films-app/production/"
      }
    }
  }
  
  This file is retained for reference only and is NOT used in cloud deployments.
  Remove this file from the project once migration to ASP.NET Core is complete.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    DEPRECATED: Web.config transformations are not used in cloud deployments.
    All environment-specific configuration is managed via:
    - Environment variables (set in AWS ECS Task Definition / EKS ConfigMap)
    - AWS Systems Manager Parameter Store (for non-sensitive config)
    - AWS Secrets Manager (for sensitive config: passwords, API keys, tokens)
    
    Previously: <compilation xdt:Transform="RemoveAttributes(debug)" />
    Now: Set ASPNETCORE_ENVIRONMENT=Production in AWS ECS Task Definition
    
    See MIGRATION GUIDE above for details.
  -->
</configuration>
