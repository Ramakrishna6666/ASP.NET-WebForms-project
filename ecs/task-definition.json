{
  "family": "films-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "films-app",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:8080"
        },
        {
          "name": "DOTNET_RUNNING_IN_CONTAINER",
          "value": "true"
        },
        {
          "name": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT",
          "value": "false"
        },
        {
          "name": "DataFilePath",
          "value": "/app/data/files"
        },
        {
          "name": "LogFilePath",
          "value": "/app/logs"
        },
        {
          "name": "TempFilePath",
          "value": "/app/temp"
        },
        {
          "name": "TZ",
          "value": "UTC"
        }
      ],
      "secrets": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{ACCOUNT_ID}}:secret:films/db-connection"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/films-app",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "films-data",
          "containerPath": "/app/data",
          "readOnly": false
        },
        {
          "sourceVolume": "films-logs",
          "containerPath": "/app/logs",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "films-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/data",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "films-logs",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/logs",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
