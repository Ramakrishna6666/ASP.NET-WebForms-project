@page "{id:int}"
@model Films.Web.Pages.Films.DeleteModel
@{
    ViewData["Title"] = "Delete Film";
}

<div class="container">
    <h1>Delete Film</h1>
    
    <h3>Are you sure you want to delete this film?</h3>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Film?.Title</dd>
                
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Film?.Description</dd>
                
                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@Model.Film?.Year</dd>
                
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@Model.Film?.Genre</dd>
            </dl>
        </div>
    </div>
    
    <form method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
